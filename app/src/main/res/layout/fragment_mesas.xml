<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical"
    tools:context=".ui.inicio.MesasFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bolinha"
            android:backgroundTint="@color/mesa_livre" />

        <TextView
            android:id="@+id/textLivres"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="24dp"
            android:textColor="@color/texto_primario"
            android:textSize="14sp"
            tools:text="Livres: 52" />

        <View
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:background="@drawable/bolinha"
            android:backgroundTint="@color/mesa_ocupada" />

        <TextView
            android:id="@+id/textOcupadas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="@color/texto_primario"
            android:textSize="14sp"
            tools:text="Ocupadas: 8" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="6dp"
        tools:itemCount="12"
        tools:listitem="@layout/item_mesa" />

</LinearLayout>
