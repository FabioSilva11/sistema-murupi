<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/margem_linha_produto"
    android:layout_marginTop="4dp"
    android:layout_marginEnd="@dimen/margem_linha_produto"
    android:layout_marginBottom="4dp"
    android:background="@drawable/fundo_item_produto"
    android:clickable="true"
    android:focusable="true"
    android:elevation="1dp"
    android:minHeight="64dp"
    android:orientation="horizontal">

    <View
        android:id="@+id/faixa"
        android:layout_width="6dp"
        android:layout_height="match_parent"
        tools:background="#2E7D32" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp">

        <TextView
            android:id="@+id/textNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_primario"
            android:textSize="16sp"
            tools:text="Isca de Frango" />

        <TextView
            android:id="@+id/textDetalhe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:visibility="gone"
            tools:text="ISCAS"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textEstoque"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Restam 3"
            tools:textColor="@color/pendente"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/textPreco"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:paddingEnd="8dp"
        android:textColor="@color/murupi_blue"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:ignore="RtlSymmetry"
        tools:text="R$ 16,00" />

    <ImageView
        android:id="@+id/seta"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_expandir"
        android:visibility="gone"
        tools:visibility="visible" />

</LinearLayout>
