<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/total_a_pagar"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/murupi_blue"
            android:textSize="32sp"
            android:textStyle="bold"
            tools:text="R$ 52,00" />

        <TextView
            android:id="@+id/textPorPessoa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_secundario"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="4 pessoas: R$ 13,00 cada"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textAvisoPendentes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/aviso_fundo"
            android:padding="8dp"
            android:textColor="@color/pendente"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchTaxa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/taxa_servico_10"
            android:visibility="gone"
            tools:text="Taxa de serviço 10% (+R$ 4,80)"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/textTotalComTaxa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/murupi_blue"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Com taxa: R$ 52,80"
            tools:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/forma_pagamento"
            android:textColor="@color/texto_primario"
            android:textSize="15sp"
            android:textStyle="bold" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/grupoForma"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDinheiro"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forma_dinheiro" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDebito"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forma_debito" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCredito"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forma_credito" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipPix"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/forma_pix" />
        </com.google.android.material.chip.ChipGroup>

        <TextView
            android:id="@+id/textErroForma"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/escolha_forma_pagamento"
            android:textColor="@color/observacao"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutRecebido"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/valor_recebido"
            android:visibility="gone"
            app:prefixText="@string/simbolo_real">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/editRecebido"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789.,"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/textTroco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/enviado"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Troco: R$ 8,00" />
    </LinearLayout>
</ScrollView>
