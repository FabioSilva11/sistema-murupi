<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fundo"
    android:orientation="vertical">

    <include
        android:id="@+id/barra"
        layout="@layout/app_bar" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/conteudo"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card de Valores e Resumo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/textIdentificacao"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/murupi_blue_escuro"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        tools:text="MESA 9.1" />

                    <TextView
                        android:id="@+id/textPessoas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp"
                        tools:text="4 pessoas: R$ 25,00 cada" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#E0E0E0" />

                    <!-- Linha Subtotal -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/subtotal"
                            android:textColor="@color/texto_primario"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/textSubtotal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/texto_primario"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            tools:text="R$ 100,00" />
                    </LinearLayout>

                    <!-- Switch Taxa de Serviço -->
                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTaxa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/taxa_servico_10"
                        tools:text="Taxa de serviço 10% (+R$ 10,00)" />

                    <!-- Campo Desconto -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutDesconto"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/desconto_opcional"
                            app:prefixText="@string/simbolo_real">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editDesconto"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789.,"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="12dp"
                        android:background="#E0E0E0" />

                    <!-- Linha Total Geral -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_a_pagar"
                            android:textColor="@color/texto_primario"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/textTotalGeral"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/murupi_blue"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            tools:text="R$ 110,00" />
                    </LinearLayout>

                    <!-- Restante ou Troco -->
                    <TextView
                        android:id="@+id/textRestante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:textColor="@color/observacao"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:text="Falta: R$ 50,00" />

                    <TextView
                        android:id="@+id/textTroco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:gravity="end"
                        android:textColor="@color/enviado"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone"
                        tools:text="Troco: R$ 10,00" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Card de Pagamentos -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/forma_pagamento"
                        android:textColor="@color/texto_primario"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Escolha do método de pagamento -->
                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/grupoFormas"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        app:selectionRequired="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDinheiro"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/forma_dinheiro" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipPix"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forma_pix" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipDebito"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forma_debito" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipCredito"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/forma_credito" />
                    </com.google.android.material.chip.ChipGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/layoutValorPagamento"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:hint="@string/total_a_pagar"
                            app:prefixText="@string/simbolo_real">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editValorPagamento"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:digits="0123456789.,"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAdicionarPagamento"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/adicionar" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/pagamentos_registrados"
                        android:textColor="@color/texto_secundario"
                        android:textSize="13sp" />

                    <!-- Container com a lista de pagamentos adicionados -->
                    <LinearLayout
                        android:id="@+id/containerPagamentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/textSemPagamentos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/nenhum_pagamento_adicionado"
                        android:textColor="@color/texto_secundario"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Rodapé com botão de confirmação e fechamento definitivo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalizar"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/finalizar_fechar_conta"
            android:textSize="16sp"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
