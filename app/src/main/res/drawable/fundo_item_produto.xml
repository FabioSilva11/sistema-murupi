    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/white" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#E5EAF2" />
        </shape>
    </item>
</ripple>
